# ── Cloudinary (optional — image sharing) ────────────────────────────────────
# Sign up at https://cloudinary.com (free tier: 25 GB/month)
# Create an unsigned upload preset and copy your Cloud Name from the Dashboard.
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name

# ── Groq API (AI lesson design suggestions) ───────────────────────────────────
# Get your key at https://console.groq.com → API Keys.
# This key is used ONLY by the backend server and is NEVER sent to the browser.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Backend CORS (optional) ───────────────────────────────────────────────────
# Comma-separated allowed origins for the API server.
# Example for an external deployment: https://yourapp.vercel.app
# Leave blank when using Docker Compose (nginx proxies locally).
CORS_ORIGIN=

# ── Frontend API base URL (optional) ─────────────────────────────────────────
# Only set this when the backend is hosted on a separate domain.
# Leave blank for Docker/local dev (Vite proxy or nginx handles /api/*).
VITE_API_BASE_URL=
