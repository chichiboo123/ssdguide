# ── API backend ──────────────────────────────────────────────────
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY server ./server
COPY tsconfig.server.json ./

EXPOSE 3001

# tsx runs TypeScript directly — no separate compile step needed
CMD ["npx", "tsx", "server/index.ts"]
